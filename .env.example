# ─────────────────────────────────────────
# Bundlbite Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────

# ── LLM: Choose ONE (priority: Ollama > Groq > OpenAI) ──────────────────────

# Option 1: Ollama local (FREE — recommended for dev)
# Run: ollama pull qwen3:8b && ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Option 2: Groq API (FREE tier — recommended for prod)
# Get key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen-qwq-32b

# Option 3: OpenAI (fallback only)
OPENAI_API_KEY=

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SCRAPER_URL=http://localhost:8001

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Get from: https://clerk.com/dashboard
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── App Config ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
