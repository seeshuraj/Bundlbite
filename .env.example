# ─────────────────────────────────────────────────────────────────
# Bundlbite Environment Variables
# Copy to .env — fill in NVIDIA_API_KEY to get started instantly
# ─────────────────────────────────────────────────────────────────

# ── LLM: NVIDIA NIM — Qwen3-Coder-480B (FREE) ───────────────────
# Get your free key: https://build.nvidia.com/qwen/qwen3-coder-480b-a35b-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3-coder-480b-a35b-instruct

# ── Infrastructure ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SCRAPER_URL=http://localhost:8001

# ── Database (Supabase) ──────────────────────────────────────────
# https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Auth (Clerk) ─────────────────────────────────────────────────
# https://clerk.com/dashboard
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── App Config ───────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
